<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.UserMapper">

    <select id="search" resultType="com.example.pojo.vo.UserInfoVO">
        select
            u.id,
            u.name,
            u.username,
            u.role_code,
            u.valid_start_time,
            u.valid_end_time,
            u.create_time,
            u.last_login_time
        from t_user u
        <where>
            <if test="userPageDTO.id != null">
                u.id = #{userPageDTO.id}
            </if>
            <if test="userPageDTO.name != null and userPageDTO.name != ''">
                and u.name like concat('%', #{userPageDTO.name}, '%')
            </if>
            <if test="userPageDTO.username != null and userPageDTO.username != ''">
                and u.username like concat('%', #{userPageDTO.username}, '%')
            </if>
        </where>
    </select>
</mapper>
